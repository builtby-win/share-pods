# Copy to .env and fill real values. .env is gitignored.

# Optional; release scripts default to builtby-win/share-pods.
GH_REPO=builtby-win/share-pods

# Set per release, or pass inline: VERSION=1.0.0 bash scripts/release.sh
# VERSION=1.0.0

# Apple Developer ID notarization credentials.
APPLE_ID=you@example.com
APPLE_TEAM_ID=TEAMID
APPLE_APP_PASSWORD=app-specific-password

# Sparkle EdDSA private key from scripts/generate-sparkle-keys.sh.
# Keep this secret. The matching public key goes in SUPublicEDKey in the Xcode project.
SPARKLE_PRIVATE_KEY=private-key-from-generate-keys
